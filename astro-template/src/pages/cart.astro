---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/products";

const products = getProducts();
---

<Layout title="Cart — astro">
  <div class="cart-header">
    <h1>Shopping Cart</h1>
    <span id="cart-count" class="cart-count"></span>
  </div>

  <div id="empty-state" hidden>
    <p class="muted">Your cart is empty. <a href="/products">Continue shopping</a></p>
  </div>

  <div id="cart-content" hidden>
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="cart-rows"></tbody>
    </table>

    <div class="summary">
      <span>Total</span>
      <strong id="cart-total">0.00€</strong>
    </div>

    <div class="actions">
      <a href="/products" class="btn btn-outline">Continue shopping</a>
      <button class="btn btn-primary" id="checkout-btn">Proceed to checkout</button>
    </div>
  </div>
</Layout>

<script define:vars={{ products }}>
  function formatPrice(n) {
    return n.toFixed(2) + "€";
  }

  function getCart() {
    try {
      return JSON.parse(sessionStorage.getItem("cart") || "[]");
    } catch {
      return [];
    }
  }

  function saveCart(cart) {
    sessionStorage.setItem("cart", JSON.stringify(cart));
    window.dispatchEvent(new Event("cart-updated"));
  }

  function createRow(product, item) {
    const lineTotal = product.price * item.qty;

    const a = document.createElement("a");
    a.href = `/products/${product.id}`;
    a.className = "product-link";
    const img = document.createElement("img");
    img.src = product.image;
    img.alt = product.name;
    img.className = "thumb";
    const nameSpan = document.createElement("span");
    nameSpan.className = "product-name";
    nameSpan.textContent = product.name;
    a.append(img, nameSpan);
    const tdProduct = document.createElement("td");
    tdProduct.appendChild(a);

    const tdPrice = document.createElement("td");
    tdPrice.textContent = formatPrice(product.price);

    const btnDec = document.createElement("button");
    btnDec.className = "qty-btn";
    btnDec.dataset.id = String(product.id);
    btnDec.dataset.action = "dec";
    btnDec.textContent = "−";
    const qtySpan = document.createElement("span");
    qtySpan.textContent = String(item.qty);
    const btnInc = document.createElement("button");
    btnInc.className = "qty-btn";
    btnInc.dataset.id = String(product.id);
    btnInc.dataset.action = "inc";
    btnInc.textContent = "+";
    const qtyDiv = document.createElement("div");
    qtyDiv.className = "qty-ctrl";
    qtyDiv.append(btnDec, qtySpan, btnInc);
    const tdQty = document.createElement("td");
    tdQty.appendChild(qtyDiv);

    const tdLineTotal = document.createElement("td");
    tdLineTotal.textContent = formatPrice(lineTotal);

    const removeBtn = document.createElement("button");
    removeBtn.className = "btn btn-danger remove-btn";
    removeBtn.dataset.id = String(product.id);
    removeBtn.textContent = "Remove";
    const tdRemove = document.createElement("td");
    tdRemove.appendChild(removeBtn);

    const tr = document.createElement("tr");
    tr.append(tdProduct, tdPrice, tdQty, tdLineTotal, tdRemove);
    return { tr, lineTotal };
  }

  function render() {
    const cart = getCart();
    const empty = document.getElementById("empty-state");
    const content = document.getElementById("cart-content");
    const tbody = document.getElementById("cart-rows");
    const totalEl = document.getElementById("cart-total");
    const countEl = document.getElementById("cart-count");

    const totalItems = cart.reduce((s, i) => s + i.qty, 0);
    if (countEl) countEl.textContent = totalItems > 0 ? `${totalItems} item${totalItems !== 1 ? "s" : ""} in your cart` : "";

    if (cart.length === 0) {
      empty.hidden = false;
      content.hidden = true;
      return;
    }

    empty.hidden = true;
    content.hidden = false;

    let total = 0;
    tbody.innerHTML = "";

    cart.forEach((item) => {
      const product = products.find((p) => p.id === item.id);
      if (!product) return;
      const { tr, lineTotal } = createRow(product, item);
      total += lineTotal;
      tbody.appendChild(tr);
    });

    totalEl.textContent = formatPrice(total);

    tbody.querySelectorAll(".remove-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        saveCart(getCart().filter((i) => i.id !== Number(btn.dataset.id)));
        render();
      });
    });

    tbody.querySelectorAll(".qty-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = Number(btn.dataset.id);
        const action = btn.dataset.action;
        const updated = getCart()
          .map((i) => i.id === id ? { ...i, qty: i.qty + (action === "inc" ? 1 : -1) } : i)
          .filter((i) => i.qty > 0);
        saveCart(updated);
        render();
      });
    });
  }

  render();

  document.getElementById("checkout-btn")?.addEventListener("click", () => {
    alert("Checkout is not implemented in this demo.");
  });
</script>

<style is:global>
  .cart-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .cart-header h1 { margin: 0; }

  .cart-count {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .muted { color: var(--muted); font-size: 0.9rem; }
  .muted a { color: var(--text); }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 1rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
    vertical-align: middle;
  }

  th {
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--muted);
  }

  tbody tr:last-child td { border-bottom: none; }

  .product-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .product-link:hover .product-name { color: var(--muted); }

  .thumb {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
    background: var(--surface);
  }

  .product-name {
    font-weight: 500;
    font-size: 0.88rem;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .qty-ctrl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
  }

  .qty-btn {
    width: 24px;
    height: 24px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-btn:hover { border-color: var(--muted); }

  .summary {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .summary strong { font-size: 1.2rem; color: var(--text); font-weight: 600; }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
